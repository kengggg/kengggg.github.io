---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { settings, type Language } from '../data/settings';
import defaultCover from '../assets/images/generic/main-cover.webp';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SVGSprite from '../components/SVGSprite.astro';
import '../styles/global.scss';

interface Props {
  title: string;
  description?: string;
  featuredImage?: ImageMetadata;
  lang?: Language;
  type?: 'website' | 'article';
  publishedTime?: Date;
  tags?: string[];
  noindex?: boolean;
}

const {
  title, description = settings.description, featuredImage = defaultCover,
  lang = settings.language, type = 'website', publishedTime, tags = [], noindex = false,
} = Astro.props;
const pageTitle = Astro.url.pathname === '/' ? `${settings.title} – ${title}` : `${title} – ${settings.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = await getImage({ src: featuredImage, width: 1200, format: 'jpg' });
const fullFeaturedImage = new URL(socialImage.src, Astro.site).toString();
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={settings.favicon} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    <link rel="alternate" type="application/rss+xml" title={settings.title} href="/feed.xml" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={settings.twitterHandle} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullFeaturedImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={settings.title} />
    <meta property="og:locale" content={lang === 'th' ? 'th_TH' : 'en_GB'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullFeaturedImage} />
    <meta property="og:image:width" content={socialImage.attributes.width} />
    <meta property="og:image:height" content={socialImage.attributes.height} />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {type === 'article' && <meta property="article:author" content={settings.author} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={settings.fontUrl} rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main-content" lang="en">Skip to content</a>
    <SVGSprite />
    <Header featuredImage={featuredImage} />
    <main id="main-content" class="page" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
