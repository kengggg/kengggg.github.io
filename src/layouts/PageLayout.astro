---
import BaseLayout from './BaseLayout.astro';
import type { ImageMetadata } from 'astro';
import type { Language } from '../data/settings';

interface Props {
  title: string;
  subtitle?: string;
  description?: string;
  featuredImage?: ImageMetadata;
  lang?: Language;
}

const { title, subtitle, description, featuredImage, lang } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  featuredImage={featuredImage}
  lang={lang}
  type="website"
>
  <section class="intro">
    <div class="wrap">
      <h1>{title}</h1>
      {subtitle && <p>{subtitle}</p>}
    </div>
  </section>

  <section class="single">
    <div class="wrap">
      <slot />
    </div>
  </section>
</BaseLayout>
