---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPostCard from '../components/BlogPostCard.astro';
import { settings } from '../data/settings';
import { fetchPublishedPosts, paginatePosts, sortPostsByDate } from '../utils/posts';

const publishedPosts = await fetchPublishedPosts();
const sortedPosts = sortPostsByDate(publishedPosts);
const { posts, totalPages } = paginatePosts(sortedPosts, settings.postsPerPage, 1);
const hasNextPage = totalPages > 1;
---

<BaseLayout
  title={settings.author}
>
  <h1 class="sr-only" lang="en">Latest posts</h1>
  <section class="blog single">
    <div class="wrap">
      {posts.map((post, index) => (
        <BlogPostCard post={post} eager={index === 0} />
      ))}
    </div>
  </section>

  {totalPages > 1 && (
    <nav class="pagination" aria-label="Blog pagination" lang="en">
      {hasNextPage && (
        <div class="pagination__next">
          <a href="/blog/2/" class="button button--large">
            <span>Older Posts</span>
            <svg class="icon" aria-hidden="true"><use href="#icon-angle-right"></use></svg>
          </a>
        </div>
      )}
    </nav>
  )}
</BaseLayout>
