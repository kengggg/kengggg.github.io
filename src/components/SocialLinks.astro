---
import { settings } from '../data/settings';
---

<ul class="socials">
  {settings.social.map(({ url, icon, title }) => (
    <li class="socials__item">
      <a href={url} target="_blank" rel="noopener noreferrer" class="socials__item__link" aria-label={`${title} (opens in a new tab)`}>
        <svg class="icon" aria-hidden="true"><use href={`#icon-${icon}`}></use></svg>
      </a>
    </li>
  ))}
</ul>
